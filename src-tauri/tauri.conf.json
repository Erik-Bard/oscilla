{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oscilla",
  "version": "0.1.0",
  "identifier": "com.erikbard.oscilla",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "oscilla",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://sdk.scdn.co; frame-src https://sdk.scdn.co; connect-src ipc: http://ipc.localhost https://api.spotify.com; img-src 'self' data: https://*.scdn.co https://*.spotifycdn.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
